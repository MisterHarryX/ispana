# Copy to .env.local for local development; on Vercel set these in Project → Settings → Environment Variables.
ADMIN_PASSWORD=
# Optional: signs the panel session cookie (defaults to a value derived from the password).
ADMIN_SECRET=
ADMIN_TZ=Europe/Moscow
# Upstash Redis (set automatically when the store is connected to the Vercel project).
KV_REST_API_URL=
KV_REST_API_TOKEN=
